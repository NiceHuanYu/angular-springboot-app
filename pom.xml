<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.2</version>
        <relativePath/> <!-- lookup parent from repository -->
    </parent>

    <groupId>top.huanyu666</groupId>
    <artifactId>my-fullstack-app</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>pom</packaging>



    <properties>
        <java.version>25</java.version>
        <frontend-maven-plugin.version>1.15.1</frontend-maven-plugin.version>
        <node.version>v24.19.0</node.version>
        <!-- 以下 3 个属性覆盖 Boot 4.1.2 BOM，取值等同官方 4.2.0 的版本组合 -->
        <jackson-bom.version>3.1.8</jackson-bom.version>
        <jackson-2-bom.version>2.21.8</jackson-2-bom.version>
        <logback.version>1.6.6</logback.version>
        <json-smart.version>2.6.1</json-smart.version>
    </properties>

    <modules>
        <module>frontend</module>
        <module>backend</module>
    </modules>

</project>
